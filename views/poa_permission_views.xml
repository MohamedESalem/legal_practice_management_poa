<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poa_permission_tree" model="ir.ui.view">
        <field name="name">poa.permission.list</field>
        <field name="model">poa.permission</field>
        <field name="arch" type="xml">
            <list string="POA Authorities">
                <field name="name_en" string="Authority Name (English)"/>
                <field name="name_ar" string="Authority Name (Arabic)"/>
                <field name="description_en" string="Authority Description (English)"/>
                <field name="description_ar" string="Authority Description (Arabic)"/>
            </list>
        </field>
    </record>

    <record id="view_poa_permission_form" model="ir.ui.view">
        <field name="name">poa.permission.form</field>
        <field name="model">poa.permission</field>
        <field name="arch" type="xml">
            <form string="POA Authority">
                <sheet>
                    <group string="Authority Name">
                        <field name="name_en" placeholder="e.g., Representation before courts"/>
                        <field name="name_ar" placeholder="مثلاً: التمثيل أمام المحاكم"/>
                    </group>
                    <group string="Authority Description">
                        <field name="description_en"/>
                        <field name="description_ar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_poa_permission" model="ir.actions.act_window">
        <field name="name">POA Authorities</field>
        <field name="res_model">poa.permission</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Create and manage reusable POA authorities in English and Arabic.</p>
        </field>
    </record>

    <menuitem id="menu_poa_root" name="Power of Attorney" parent="contacts.menu_contacts" sequence="90"/>
    <menuitem id="menu_poa_permissions" name="POA Authorities" parent="menu_poa_root" action="action_poa_permission" sequence="10"/>
</odoo>


